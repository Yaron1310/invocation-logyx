<?xml version="1.0"?>
<ruleset name="Invocation">
	<description>WordPress Coding Standards for the Invocation plugin.</description>

	<!-- What to scan. -->
	<file>invocation.php</file>
	<file>inc</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tools/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<!-- Target: PHP 8.1+, WordPress 7.0+. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress">
		<!-- The plugin uses `declare(strict_types=1)`, which WPCS's file-comment
		     ordering rule does not expect. -->
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>

		<!-- Context providers and ability execute callbacks have fixed signatures
		     (`$input` / `$args`), so a given callback often does not use every
		     parameter it is required to accept. -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>

		<!-- Docblocks use PHPStan-style generics (`list<string>`,
		     `array<int, array<string, mixed>>`) which this sniff cannot parse; it
		     reports them as mismatching the literal `array` type hint. The
		     generics are intentional and more precise. -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>

	<!-- Prefix + text-domain enforcement: these are what wp.org reviewers check. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="invocation"/>
				<element value="INVOCATION"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="invocation"/>
			</property>
		</properties>
	</rule>
</ruleset>
